# ============================================================
# Komunity Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to source control (it is in .gitignore).
# ============================================================

# --- Django Core ---
SECRET_KEY=your-secret-key-here   # or SECRET=your-secret-key-here
DJANGO_ENV=development           # set to 'production' in deployment

# --- Database ---
# Leave blank to use local SQLite (default for development)
# Set to PostgreSQL URL in production
DATABASE_URL=

# --- Allowed Hosts (production only) ---
# Comma-separated list of additional hosts to allow
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Developer LAN IPs (local only, never commit to source control) ---
# Add your machine's LAN IP so the dev server is reachable from a physical device.
# e.g. EXTRA_ALLOWED_HOSTS=192.168.1.100
# e.g. EXTRA_CSRF_ORIGINS=http://192.168.1.100:8000
EXTRA_ALLOWED_HOSTS=
EXTRA_CSRF_ORIGINS=

# --- Email (SMTP) ---
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# --- Flutterwave Payments ---
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=

# --- Fernet Encryption (for bank/mobile-money account numbers at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Meta WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Cloudflare R2 Storage (for production media files) ---
# Create an R2 bucket in the Cloudflare dashboard, then generate an API token
# with Object Read & Write permissions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: custom public domain (e.g. media.komunity.co.za) for serving files
R2_PUBLIC_CUSTOM_DOMAIN=

# --- Landing Page ---
LANDING_PAGE_URL=http://localhost:3000
